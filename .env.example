# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cogniflow
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cogniflow?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI (Get your key from platform.openai.com)
OPENAI_API_KEY=

# Clerk (dashboard.clerk.com → API keys). The API needs the secret key (or CLERK_JWT_KEY);
# the web app reads NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY from apps/web/.env.local.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# App
PORT=3000
API_URL=http://localhost:3001
